# The API key stays on the Mac. Never copy it into the iOS app.
WELLPHONE_PROVIDER=zai
WELLPHONE_MODEL=glm-5.2
ZAI_API_KEY=
YOUTUBE_API_KEY=

# Optional MCP Server. Every tool from a configured Server is exposed to the
# Agent, so only configure trusted, preferably read-only Servers.
# WELLPHONE_MCP_NOTES_URL=http://127.0.0.1:9000/mcp
# WELLPHONE_MCP_NOTES_TOKEN=

# Optional: use a cheaper model for memory Gate and extraction.
# Defaults to WELLPHONE_PROVIDER / WELLPHONE_MODEL.
# WELLPHONE_MEMORY_PROVIDER=deepseek
# WELLPHONE_MEMORY_MODEL=deepseek-v4-flash

# Optional server settings
WELLPHONE_HOST=0.0.0.0
WELLPHONE_PORT=8000
WELLPHONE_TOOL_TIMEOUT=180
